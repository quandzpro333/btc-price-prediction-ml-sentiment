# Sao chép file này thành ".env" (cùng thư mục) rồi điền giá trị thật của bạn.
# cp .env.example .env

# Database — mặc định dùng SQLite (không cần cài thêm gì)
DATABASE_URL=sqlite:///./btc_prediction.db

# Gemini API key — lấy tại https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# (Tuỳ chọn) News API — lấy tại https://newsapi.org
NEWS_API_KEY=

# (Tuỳ chọn) X/Twitter API v2 Bearer Token — https://developer.x.com
TWITTER_BEARER_TOKEN=

# Thư mục chứa model ML đã train (mặc định trỏ tới ../ml/artifacts)
ML_MODEL_DIR=../ml/artifacts

# Origin của frontend Next.js khi chạy local (dùng cho CORS)
FRONTEND_ORIGIN=http://localhost:3000
